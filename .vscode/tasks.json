{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RetroTuner3DS: Host tests",
      "type": "shell",
      "command": "./tests/run_live_host_tests.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "RetroTuner3DS: Build 3DSX",
      "type": "shell",
      "command": "make",
      "args": ["3dsx", "-j4"],
      "options": {
        "env": {
          "DEVKITPRO": "/opt/devkitpro",
          "DEVKITARM": "/opt/devkitpro/devkitARM",
          "PATH": "/opt/devkitpro/devkitARM/bin:/opt/devkitpro/tools/bin:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "RetroTuner3DS: Clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "env": {
          "DEVKITPRO": "/opt/devkitpro",
          "DEVKITARM": "/opt/devkitpro/devkitARM",
          "PATH": "/opt/devkitpro/devkitARM/bin:/opt/devkitpro/tools/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    }
  ]
}
